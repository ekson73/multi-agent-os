#!/usr/bin/env bash
# Layer Purity verification — scans candidate-for-community files for organization-specific strings
# Spec: docs/governance/promotion-readiness-checklist.md §"Layer Purity"
# Origin: Track A.5 of ASH-lite portability refactor plan
# Aligns with: ~/.claude/rules/layer-precedence-policy.md Rule 2 (Layer Purity)
#
# Usage:
#   bin/check-layer-purity <file-or-glob> [<file-or-glob>...]
#   bin/check-layer-purity --hooks      # shorthand: scan promoted Layer-1 hooks (skills/agentic-session-harness/hooks/*.sh)
#   bin/check-layer-purity --candidates # shorthand: scan all promotion candidates
#   bin/check-layer-purity --json       # machine-readable output
#
# Exit codes:
#   0 = clean (zero violations), or skipped on a fork pull request with no patterns
#   1 = violations found, or CI with no patterns configured
#   2 = usage error / file not found
set -euo pipefail

# Organization-specific strings to flag (case-insensitive), one ERE per entry.
# The framework ships only a neutral default. Real organization names, project keys
# and domains are installation config and are never compiled into this file.
#   MAOS_LAYER_PURITY_PATTERNS       newline-separated EREs
#                                    (in CI: the LAYER_PURITY_PATTERNS repository variable)
#   MAOS_LAYER_PURITY_PATTERNS_FILE  file with one ERE per line, '#' comments allowed
#                                    (default: ~/.config/maos/layer-purity-patterns.txt)
# /**
#  * Unconfigured patterns must not look like a clean scan.
#  * @context The neutral default (\bLGPD\b) is always loaded, so an empty config used to exit 0.
#  * @reason A green run with no org patterns hides that the promotion gate checked almost nothing.
#  * @impact Local runs warn and still scan the default. CI fails. A fork pull request warns and skips.
#  */
PATTERNS=(
  '\bLGPD\b'
)
_lp_configured=0
_lp_file="${MAOS_LAYER_PURITY_PATTERNS_FILE:-${HOME:-}/.config/maos/layer-purity-patterns.txt}"
if [ -f "$_lp_file" ]; then
  while IFS= read -r _lp || [ -n "$_lp" ]; do
    case "$_lp" in
      ''|'#'*) continue ;;
      *) _lp_configured=1; PATTERNS+=("$_lp") ;;
    esac
  done < "$_lp_file"
fi
if [ -n "${MAOS_LAYER_PURITY_PATTERNS:-}" ]; then
  while IFS= read -r _lp; do
    if [ -n "$_lp" ]; then
      _lp_configured=1
      PATTERNS+=("$_lp")
    fi
  done <<< "$MAOS_LAYER_PURITY_PATTERNS"
fi

# CI is GitHub Actions, or any runner that exports CI=true.
_lp_in_ci() {
  [ "${GITHUB_ACTIONS:-}" = "true" ] || [ "${CI:-}" = "true" ]
}

# Fork pull requests do not carry the upstream repository variable.
_lp_fork_pr() {
  [ "${GITHUB_EVENT_NAME:-}" = "pull_request" ] || return 1
  [ -n "${GITHUB_EVENT_PATH:-}" ] && [ -f "${GITHUB_EVENT_PATH}" ] || return 1
  local fork="false"
  if command -v jq >/dev/null 2>&1; then
    fork="$(jq -r 'if .pull_request.head.repo.fork == true then "true" else "false" end' "${GITHUB_EVENT_PATH}" 2>/dev/null || echo false)"
  fi
  [ "$fork" = "true" ]
}

# Fork pull_request is the only CI event that skips. push (including push to
# main) and workflow_dispatch fail when no patterns are configured, because the
# repository variable is available on those events.
_lp_unconfigured_gate() {
  [ "$_lp_configured" -eq 0 ] || return 0
  if _lp_in_ci; then
    if _lp_fork_pr; then
      echo "::warning::Layer Purity check skipped: no patterns configured (pull request from a fork; LAYER_PURITY_PATTERNS is not set)."
      exit 0
    fi
    echo "error: Layer Purity: no patterns configured. Set MAOS_LAYER_PURITY_PATTERNS, MAOS_LAYER_PURITY_PATTERNS_FILE, or the LAYER_PURITY_PATTERNS repository variable. Refusing to pass silently." >&2
    exit 1
  fi
  echo "warning: Layer Purity: no patterns configured (MAOS_LAYER_PURITY_PATTERNS, MAOS_LAYER_PURITY_PATTERNS_FILE, or the CI variable LAYER_PURITY_PATTERNS). Scanning the neutral default only." >&2
}

MODE="text"
FILES=()

usage() {
  sed -n '2,15p' "$0"
  exit 0
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    --json) MODE="json"; shift ;;
    --hooks)
      # Promoted Layer-1 bundle hooks (pre-promotion paths .claude/hooks/ash-*.sh no longer exist).
      FILES+=(
        skills/agentic-session-harness/hooks/link.sh
        skills/agentic-session-harness/hooks/resume.sh
        skills/agentic-session-harness/hooks/stop-fallback.sh
        skills/agentic-session-harness/hooks/decide-merge.sh
        skills/agentic-session-harness/hooks/lib.sh
      )
      shift ;;
    --candidates)
      # FULL promoted Layer-1 bundle (hooks + CLIs + docs) — scan everything that shipped, so a
      # clean run cannot be reported while skipping promoted files (the v1 bug this preset had).
      FILES+=(
        skills/agentic-session-harness/hooks/link.sh
        skills/agentic-session-harness/hooks/resume.sh
        skills/agentic-session-harness/hooks/stop-fallback.sh
        skills/agentic-session-harness/hooks/decide-merge.sh
        skills/agentic-session-harness/hooks/lib.sh
        skills/agentic-session-harness/bin/agentic-walkthrough
        skills/agentic-session-harness/bin/agentic-decide
        skills/agentic-session-harness/bin/agentic-decisions
        skills/agentic-session-harness/bin/agentic-reindex
        skills/agentic-session-harness/bin/agentic-fix-dangling-symlinks.sh
        skills/agentic-session-harness/SKILL.md
        skills/agentic-session-harness/SPEC.md
        skills/walkthrough-concierge/SKILL.md
        skills/walkthrough-concierge/awareness-registry.md
        skills/walkthrough-concierge/canon.md
        skills/decision-capture/SKILL.md
      )
      shift ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) FILES+=("$1"); shift ;;
  esac
done

[ ${#FILES[@]} -eq 0 ] && { echo "Usage: $(basename "$0") <file>... | --hooks | --candidates [--json]" >&2; exit 2; }

_lp_unconfigured_gate

# Build combined regex (alternation) for grep -E.
# printf-join (not an `IFS='|'` subshell): subshell-IFS is safe but trips a global-IFS lint;
# printf is clearer and lint-clean. Trailing '|' stripped via parameter expansion.
JOINED_RE=$(printf '%s|' "${PATTERNS[@]}"); JOINED_RE="${JOINED_RE%|}"

VIOLATIONS=0
MISSING_FILES=0
RESULTS=()

for f in "${FILES[@]}"; do
  [ -f "$f" ] || { echo "File not found: $f" >&2; MISSING_FILES=$((MISSING_FILES+1)); continue; }
  # -E extended regex, -i case-insensitive, -n line numbers, -H filename
  while IFS= read -r line; do
    VIOLATIONS=$((VIOLATIONS+1))
    RESULTS+=("$line")
  done < <(grep -EHniI "$JOINED_RE" "$f" 2>/dev/null || true)
done

# A missing input (typo / stale path) is a USAGE error (exit 2), not a clean run — fail fast
# BEFORE printing any status so stdout never claims "0 violations / clean" while exiting 2.
if [ "$MISSING_FILES" -gt 0 ]; then
  echo "Missing input file(s): $MISSING_FILES (usage error — stale/typo path)" >&2
  exit 2
fi

if [ "$MODE" = "json" ]; then
  printf '{"violations": %d, "patterns": %d, "details": [' "$VIOLATIONS" "${#PATTERNS[@]}"
  first=1
  for r in "${RESULTS[@]}"; do
    [ $first -eq 1 ] && first=0 || printf ','
    # Escape line for JSON
    printf '%s' "$r" | jq -Rs .
  done
  printf ']}\n'
else
  if [ "$VIOLATIONS" -eq 0 ]; then
    echo "✅ Layer Purity clean: 0 violations across ${#FILES[@]} file(s)"
  else
    echo "🚨 Layer Purity: $VIOLATIONS violation(s) found"
    echo ""
    printf '%s\n' "${RESULTS[@]}"
    echo ""
    echo "Patterns scanned: ${#PATTERNS[@]} organization-specific terms"
    echo "Action: sanitize (use placeholders) OR keep file project-scoped per layer-precedence-policy Rule 2"
  fi
fi

[ "$VIOLATIONS" -eq 0 ] && exit 0 || exit 1
