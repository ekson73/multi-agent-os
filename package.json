{
  "name": "maos",
  "version": "1.22.1",
  "description": "MAOS (Multi-Agent OS) \u2014 skills pack for multi-agent coordination. Claude plugin + Pi package + OpenCode plugin entrypoints.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekson73/multi-agent-os.git"
  },
  "homepage": "https://github.com/ekson73/multi-agent-os",
  "bugs": {
    "url": "https://github.com/ekson73/multi-agent-os/issues"
  },
  "keywords": [
    "agent-skills",
    "agentskills",
    "ai-agents",
    "maos",
    "multi-agent",
    "orchestration",
    "pi-package",
    "skills-sh"
  ],
  "files": [
    "skills/**/SKILL.md",
    "skills/**/*.md",
    "skills/*/scripts/**",
    "skills/*/bin/**",
    "skills/agentic-session-harness/hooks/lib.sh",
    "bin/self-heal-relay-render",
    "skills/instrument-self-heal-relay/harnesses.json",
    "skills/instrument-self-heal-relay/templates/*.tmpl",
    "skills/decompose-abstract-to-measurable/examples/*.json",
    "skills/decompose-abstract-to-measurable/templates/*.json",
    "skills/goal-recovery/templates/*.json",
    "skills/ooda-loop/templates/*.json",
    "!skills/system-health-responder/bin/**",
    "!skills/transcript-corrector/scripts/**",
    "!skills/**/__pycache__/**",
    "!skills/**/*.pyc",
    "!skills/*/scripts/**/tests/**",
    "!skills/*/scripts/**/fixtures/**",
    "!skills/*/bin/**/tests/**",
    "!skills/*/bin/**/fixtures/**",
    "!skills/*/scripts/**/*-test.*",
    "!skills/*/scripts/**/*_test.*",
    "!skills/*/scripts/**/test_*",
    "!skills/*/scripts/**/test-*",
    "!skills/*/bin/**/*-test.*",
    "!skills/*/bin/**/*_test.*",
    "!skills/*/bin/**/test_*",
    "!skills/*/bin/**/test-*",
    "packaging/**",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate:skills": "bash scripts/validate-skill-frontmatter.sh"
  }
}
