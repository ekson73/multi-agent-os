    const txt = e && e.stack ? e.stack : String(e);
    _shr.fs.writeSync(2, txt + "\n");
    try { shrRelay(txt); } catch (_) {}
    process.exitCode = 1;
    setImmediate(() => process.exit(1)); // deferred: listeners the adopter registered AFTER this one still run (locks, temp files) before the process ends
  };
