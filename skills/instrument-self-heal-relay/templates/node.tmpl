}

if (SHR_ON) {
  try { _shrDir = _shr.fs.mkdtempSync(_shr.path.join(_shr.os.tmpdir(), "shr.")); } // mode 0700
  catch (e) { // an unusable TMPDIR must never turn a healthy program into a failing one: run uninstrumented
    process.stderr.write(`self-heal-relay: no usable temp dir (${e.code || e.message}); relay disabled for this run\n`);
    SHR_ON = false;
  }
}
if (SHR_ON) {
  _shrLog = _shr.path.join(_shrDir, "run.log");
  const _w = process.stderr.write.bind(process.stderr);
  process.stderr.write = (c, ...a) => { try { _shr.fs.appendFileSync(_shrLog, c); } catch (_) {} return _w(c, ...a); };
