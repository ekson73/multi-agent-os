  [/(AKIA|ASIA)[0-9A-Z]{16}/g, "[REDACTED:aws-key-id]"],
  [/(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}/g, "[REDACTED:github-token]"],
  [/sk-[A-Za-z0-9_-]{20,}/g, "[REDACTED:api-key]"],
  [/xox[baprs]-[A-Za-z0-9-]{10,}/g, "[REDACTED:slack-token]"],
  [/eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{4,}/g, "[REDACTED:jwt]"],
  [/:\/\/[^/@\s]*@/g, "://[REDACTED]@"],
  [/\b(Bearer|Basic)\s+[A-Za-z0-9._~+/=-]{8,}/gi, "$1 [REDACTED]"],
  [/([A-Za-z0-9_.-]{0,64}(?:secret|token|passw(?:or)?d|api_?key|credential|auth)[A-Za-z0-9_.-]{0,64})\s*[=:]\s*("[^"]*"|'[^']*'|[^\s"']+)/gi, "$1=[REDACTED]"],
];
// Best-effort secret scrub. It cannot be exhaustive: a secret-handling script should default MAOS_SELFHEAL=0.
function shrRedact(t) { for (const [rx, rep] of _SHR_REDACT) t = t.replace(rx, rep); return t; }

let _shrDir = null, _shrLog = null, _shrRelayed = false;

// Platform-independent executable lookup (no `sh` needed, so it also works on Windows).
function shrWhich(bin) {
