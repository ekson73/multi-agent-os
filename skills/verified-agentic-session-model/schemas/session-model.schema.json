{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ekson73/multi-agent-os/skills/verified-agentic-session-model/schemas/session-model.schema.json",
  "title": "Verified Agentic Session Model v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "identity", "traceability", "metadata", "intent", "organization", "topology", "governance", "inert_material", "analysis", "plan", "lifecycle", "child_derivation", "references"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "kind": { "const": "agentic_session_model" },
    "identity": { "$ref": "#/$defs/identity" },
    "traceability": { "$ref": "#/$defs/traceability" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "intent": { "$ref": "#/$defs/intent" },
    "organization": { "$ref": "#/$defs/organization" },
    "topology": { "$ref": "#/$defs/topology" },
    "governance": { "$ref": "#/$defs/governance" },
    "inert_material": { "$ref": "#/$defs/inertMaterial" },
    "analysis": { "$ref": "#/$defs/analysis" },
    "plan": { "$ref": "#/$defs/plan" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "child_derivation": { "$ref": "#/$defs/childDerivation" },
    "references": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/reference" } }
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "slug": { "type": "string", "maxLength": 96, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]*$" },
    "language": { "type": "string", "maxLength": 35, "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "dateTime": { "type": "string", "format": "date-time", "maxLength": 64, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "nullableDateTime": { "type": ["string", "null"], "format": "date-time", "maxLength": 64, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "semver": { "type": "string", "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "publicUri": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?:https://[^\\s\\u0000-\\u001F\\u007F]+|urn:[^\\s\\u0000-\\u001F\\u007F]+)$" },
    "uri": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?:(?:https?|file|artifact|evidence|specification|journal|session-journal|local|agent|memory|issue|pr|git)://|urn:)[^\\s\\u0000-\\u001F\\u007F]+$" },
    "status": { "enum": ["planned", "started", "delegated", "deferred", "hitl", "blocked", "completed", "canceled", "superseded", "deprecated", "unknown"] },
    "evidenceRefs": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["taxonomic", "semantic", "ontological", "epistemological", "etymological", "semiotic", "chronological", "version"],
      "properties": {
        "taxonomic": { "type": "object", "additionalProperties": false, "required": ["family", "artifact_class", "subtype"], "properties": { "family": { "$ref": "#/$defs/slug" }, "artifact_class": { "$ref": "#/$defs/slug" }, "subtype": { "$ref": "#/$defs/slug" } } },
        "semantic": { "type": "object", "additionalProperties": false, "required": ["subject", "purpose"], "properties": { "subject": { "$ref": "#/$defs/slug" }, "purpose": { "$ref": "#/$defs/slug" } } },
        "ontological": { "type": "object", "additionalProperties": false, "required": ["entity_kind", "world_model"], "properties": { "entity_kind": { "$ref": "#/$defs/slug" }, "world_model": { "const": "human-agentic" } } },
        "epistemological": { "type": "object", "additionalProperties": false, "required": ["claim_mode", "evidence_class"], "properties": { "claim_mode": { "enum": ["snapshot", "verified_snapshot"] }, "evidence_class": { "enum": ["public_evidence", "mixed_sanitized_evidence"] } } },
        "etymological": { "type": "object", "additionalProperties": false, "required": ["root", "language"], "properties": { "root": { "$ref": "#/$defs/slug" }, "language": { "$ref": "#/$defs/language" } } },
        "semiotic": { "type": "object", "additionalProperties": false, "required": ["signifier", "audience"], "properties": { "signifier": { "$ref": "#/$defs/slug" }, "audience": { "enum": ["ai_first", "dual_audience"] } } },
        "chronological": { "type": "object", "additionalProperties": false, "required": ["as_of", "revision"], "properties": { "as_of": { "$ref": "#/$defs/dateTime" }, "revision": { "type": "integer", "minimum": 1, "maximum": 999999 } } },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "traceability": {
      "type": "object", "additionalProperties": false,
      "required": ["author", "ai_harness", "ai_llm", "created_at", "updated_at", "semantic_version", "git"],
      "properties": {
        "author": { "type": "object", "additionalProperties": false, "required": ["kind", "public_id", "attribution"], "properties": { "kind": { "const": "sanitized_user" }, "public_id": { "$ref": "#/$defs/slug" }, "attribution": { "enum": ["role_only", "pseudonymous"] } } },
        "ai_harness": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "$ref": "#/$defs/slug" }, "version": { "$ref": "#/$defs/text" } } },
        "ai_llm": { "type": "object", "additionalProperties": false, "required": ["provider", "model", "revision"], "properties": { "provider": { "$ref": "#/$defs/slug" }, "model": { "$ref": "#/$defs/slug" }, "revision": { "type": ["string", "null"], "maxLength": 128 } } },
        "created_at": { "$ref": "#/$defs/dateTime" }, "updated_at": { "$ref": "#/$defs/dateTime" }, "semantic_version": { "$ref": "#/$defs/semver" },
        "git": { "type": "object", "additionalProperties": false, "required": ["client_version", "tracking_state", "repository_visibility", "repository_uri", "ref_name", "commit_sha", "tree_sha"], "properties": {
          "client_version": { "$ref": "#/$defs/text" }, "tracking_state": { "enum": ["tracked_clean", "tracked_dirty", "untracked", "detached", "not_applicable", "undisclosed"] }, "repository_visibility": { "enum": ["public", "undisclosed", "not_applicable"] }, "repository_uri": { "type": ["string", "null"], "maxLength": 4096 }, "ref_name": { "type": ["string", "null"], "maxLength": 256 }, "commit_sha": { "type": ["string", "null"], "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }, "tree_sha": { "type": ["string", "null"], "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
        } }
      }
    },
    "distribution": { "type": "object", "additionalProperties": false, "required": ["classification", "references_policy", "content_policy"], "properties": { "classification": { "enum": ["local_only", "portable_sanitized"] }, "references_policy": { "enum": ["public_only", "internal_allowed"] }, "content_policy": { "enum": ["sanitized_public_only", "sanitized_internal_allowed"] } } },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["title", "scope", "language", "distribution", "created_from"], "properties": { "title": { "$ref": "#/$defs/text" }, "scope": { "$ref": "#/$defs/text" }, "language": { "$ref": "#/$defs/language" }, "distribution": { "$ref": "#/$defs/distribution" }, "created_from": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "statusItem": { "type": "object", "additionalProperties": false, "required": ["id", "title", "status", "reason", "evidence_refs"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" }, "status": { "$ref": "#/$defs/status" }, "reason": { "type": ["string", "null"], "maxLength": 4096 }, "evidence_refs": { "$ref": "#/$defs/evidenceRefs" } } },
    "criterion": { "type": "object", "additionalProperties": false, "required": ["id", "text", "status", "reason", "evidence_refs"], "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/text" }, "status": { "$ref": "#/$defs/status" }, "reason": { "type": ["string", "null"], "maxLength": 4096 }, "evidence_refs": { "$ref": "#/$defs/evidenceRefs" } } },
    "intent": { "type": "object", "additionalProperties": false, "required": ["motivations", "goal", "definition_of_ready", "definition_of_done", "objectives"], "properties": {
      "motivations": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/text" } }, "goal": { "$ref": "#/$defs/text" }, "definition_of_ready": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/criterion" } }, "definition_of_done": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/criterion" } },
      "objectives": { "type": "object", "additionalProperties": false, "required": ["originating", "primary", "secondary", "auxiliary"], "properties": { "originating": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/statusItem" } }, "primary": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/statusItem" } }, "secondary": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/statusItem" } }, "auxiliary": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/statusItem" } } } }
    } },
    "context": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "label", "project_slug", "repository_uri"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["artifact_world", "target_project_world"] }, "label": { "$ref": "#/$defs/text" }, "project_slug": { "type": ["string", "null"], "maxLength": 96 }, "repository_uri": { "type": ["string", "null"], "maxLength": 4096 } } },
    "world": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "label", "actor_refs", "domain_refs"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["human", "agentic"] }, "label": { "$ref": "#/$defs/text" }, "actor_refs": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "domain_refs": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "domain": { "type": "object", "additionalProperties": false, "required": ["id", "label", "purpose", "world_refs", "component_refs", "owner_actor_ref"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" }, "purpose": { "$ref": "#/$defs/text" }, "world_refs": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "component_refs": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "owner_actor_ref": { "$ref": "#/$defs/id" } } },
    "actor": { "type": "object", "additionalProperties": false, "required": ["id", "label", "kind", "world_ref", "capabilities", "responsibility_refs"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" }, "kind": { "enum": ["human", "human_team", "ai_agent", "agent_team", "external_tool", "system"] }, "world_ref": { "$ref": "#/$defs/id" }, "capabilities": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } }, "responsibility_refs": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "classification": { "type": "object", "additionalProperties": false, "required": ["class", "disposition"], "properties": { "class": { "enum": ["personal", "work", "org", "gov", "community", "opensource", "private", "secrets", "pii", "lgpd", "gdpr"] }, "disposition": { "enum": ["included", "excluded", "not_applicable"] } } },
    "organization": { "type": "object", "additionalProperties": false, "required": ["contexts", "worlds", "domains", "actors", "classifications"], "properties": { "contexts": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/context" } }, "worlds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/world" } }, "domains": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/domain" } }, "actors": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/actor" } }, "classifications": { "type": "array", "minItems": 11, "maxItems": 11, "items": { "$ref": "#/$defs/classification" } } } },
    "lane": { "type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" }, "variant": { "enum": ["normal", "exception"] } } },
    "phase": { "type": "object", "additionalProperties": false, "required": ["id", "label", "from_column", "to_column"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" }, "from_column": { "type": "integer", "minimum": 0, "maximum": 5 }, "to_column": { "type": "integer", "minimum": 0, "maximum": 5 }, "variant": { "enum": ["default", "emphasis", "security", "dashed"] } } },
    "group": { "type": "object", "additionalProperties": false, "required": ["id", "label", "lane", "from_column", "to_column"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" }, "lane": { "$ref": "#/$defs/id" }, "from_column": { "type": "integer", "minimum": 0, "maximum": 5 }, "to_column": { "type": "integer", "minimum": 0, "maximum": 5 }, "variant": { "enum": ["default", "emphasis", "security", "dashed"] } } },
    "node": { "type": "object", "additionalProperties": false, "required": ["id", "label", "description", "lane", "column", "component_kind", "world_ref", "domain_refs", "owner_actor_ref", "status", "reason", "evidence_refs"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" }, "description": { "type": ["string", "null"], "maxLength": 4096 }, "lane": { "$ref": "#/$defs/id" }, "column": { "type": "integer", "minimum": 0, "maximum": 5 }, "component_kind": { "enum": ["frontend", "backend", "database", "cloud", "security", "messagebus", "external"] }, "world_ref": { "$ref": "#/$defs/id" }, "domain_refs": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "owner_actor_ref": { "$ref": "#/$defs/id" }, "status": { "$ref": "#/$defs/status" }, "reason": { "type": ["string", "null"], "maxLength": 4096 }, "evidence_refs": { "$ref": "#/$defs/evidenceRefs" } } },
    "edge": { "type": "object", "additionalProperties": false, "required": ["id", "from", "to"], "properties": { "id": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" }, "variant": { "enum": ["default", "emphasis", "security", "dashed"] }, "role": { "enum": ["main", "branch", "async", "return", "error"] }, "route": { "enum": ["auto", "straight", "drop", "outside-right", "return-left", "bottom-channel", "up-channel"] }, "from_side": { "enum": ["left", "right", "top", "bottom"] }, "to_side": { "enum": ["left", "right", "top", "bottom"] }, "channel_y": { "type": "number", "minimum": 0, "maximum": 10000 }, "label_dx": { "type": "number", "minimum": -2000, "maximum": 2000 }, "label_dy": { "type": "number", "minimum": -2000, "maximum": 2000 }, "label_segment": { "type": "integer", "minimum": 0, "maximum": 20 }, "bias": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "topology": { "type": "object", "additionalProperties": false, "required": ["lanes", "phases", "groups", "nodes", "edges", "critical_path"], "properties": { "lanes": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/lane" } }, "phases": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/phase" } }, "groups": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/group" } }, "nodes": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/node" } }, "edges": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/edge" } }, "critical_path": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "responsibility": { "type": "object", "additionalProperties": false, "required": ["id", "subject_ref", "role", "actor_ref", "detail"], "properties": { "id": { "$ref": "#/$defs/id" }, "subject_ref": { "$ref": "#/$defs/id" }, "role": { "enum": ["R", "A", "C", "I"] }, "actor_ref": { "$ref": "#/$defs/id" }, "detail": { "type": ["string", "null"], "maxLength": 4096 } } },
    "authoritySnapshot": { "type": "object", "additionalProperties": false, "required": ["binding", "portable", "transferable", "status", "sanitized_scope", "observed_at"], "properties": { "binding": { "const": false }, "portable": { "const": false }, "transferable": { "const": false }, "status": { "const": "descriptive_only" }, "sanitized_scope": { "$ref": "#/$defs/text" }, "observed_at": { "$ref": "#/$defs/dateTime" } } },
    "governance": { "type": "object", "additionalProperties": false, "required": ["binding", "responsibilities", "authority_constraints", "authority_snapshot", "policy_snapshots", "acceptance_criteria"], "properties": { "binding": { "const": false }, "responsibilities": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/responsibility" } }, "authority_constraints": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/statusItem" } }, "authority_snapshot": { "$ref": "#/$defs/authoritySnapshot" }, "policy_snapshots": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "acceptance_criteria": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/criterion" } } } },
    "inertDatum": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "purpose", "content", "media_type", "source_ref", "source_sha256", "as_of", "trust_class", "binding", "effect_class", "distribution"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["seed", "dna", "template", "instruction", "prompt", "directive", "governance"] }, "purpose": { "$ref": "#/$defs/text" }, "content": { "$ref": "#/$defs/text" }, "media_type": { "enum": ["text/plain", "text/markdown", "application/json"] }, "source_ref": { "$ref": "#/$defs/id" }, "source_sha256": { "$ref": "#/$defs/sha256" }, "as_of": { "$ref": "#/$defs/dateTime" }, "trust_class": { "const": "untrusted_data" }, "binding": { "const": false }, "effect_class": { "const": "none" }, "distribution": { "const": "public" } } },
    "inertMaterial": { "type": "object", "additionalProperties": false, "required": ["seeds", "dna", "templates", "instructions", "prompts", "directives", "governance"], "properties": { "seeds": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/inertDatum" } }, "dna": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/inertDatum" } }, "templates": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/inertDatum" } }, "instructions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/inertDatum" } }, "prompts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/inertDatum" } }, "directives": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/inertDatum" } }, "governance": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/inertDatum" } } } },
    "rootCause": { "type": "object", "additionalProperties": false, "required": ["id", "problem", "why_chain", "root_cause", "evidence_refs"], "properties": { "id": { "$ref": "#/$defs/id" }, "problem": { "$ref": "#/$defs/text" }, "why_chain": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/text" } }, "root_cause": { "$ref": "#/$defs/text" }, "evidence_refs": { "$ref": "#/$defs/evidenceRefs" } } },
    "blockingItem": { "type": "object", "additionalProperties": false, "required": ["id", "title", "status", "reason", "blocking", "evidence_refs"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "description": { "type": ["string", "null"], "maxLength": 4096 }, "status": { "$ref": "#/$defs/status" }, "reason": { "type": ["string", "null"], "maxLength": 4096 }, "blocking": { "type": "boolean" }, "evidence_refs": { "$ref": "#/$defs/evidenceRefs" } } },
    "risk": { "type": "object", "additionalProperties": false, "required": ["id", "title", "status", "reason", "likelihood", "impact", "blocking", "mitigation", "evidence_refs"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "description": { "type": ["string", "null"], "maxLength": 4096 }, "status": { "$ref": "#/$defs/status" }, "reason": { "type": ["string", "null"], "maxLength": 4096 }, "likelihood": { "enum": ["low", "medium", "high", "critical"] }, "impact": { "enum": ["low", "medium", "high", "critical"] }, "blocking": { "type": "boolean" }, "mitigation": { "type": ["string", "null"], "maxLength": 4096 }, "evidence_refs": { "$ref": "#/$defs/evidenceRefs" } } },
    "analysis": { "type": "object", "additionalProperties": false, "required": ["root_causes", "gaps", "failures", "risks"], "properties": { "root_causes": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/rootCause" } }, "gaps": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/blockingItem" } }, "failures": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/statusItem" } }, "risks": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/risk" } } } },
    "nextAction": { "type": "object", "additionalProperties": false, "required": ["what", "why", "where", "when", "who", "how", "cost"], "properties": { "what": { "$ref": "#/$defs/text" }, "why": { "$ref": "#/$defs/text" }, "where": { "$ref": "#/$defs/text" }, "when": { "$ref": "#/$defs/text" }, "who": { "$ref": "#/$defs/text" }, "how": { "$ref": "#/$defs/text" }, "cost": { "type": ["string", "null"], "maxLength": 4096 } } },
    "lifecycleState": { "type": "object", "additionalProperties": false, "required": ["state", "reason", "assigned_actor_ref", "started_at", "ended_at", "resume_after", "decision_ref", "successor_ref", "evidence_refs"], "properties": { "state": { "$ref": "#/$defs/status" }, "reason": { "type": ["string", "null"], "maxLength": 4096 }, "assigned_actor_ref": { "type": ["string", "null"], "maxLength": 128 }, "started_at": { "$ref": "#/$defs/nullableDateTime" }, "ended_at": { "$ref": "#/$defs/nullableDateTime" }, "resume_after": { "$ref": "#/$defs/nullableDateTime" }, "decision_ref": { "type": ["string", "null"], "maxLength": 128 }, "successor_ref": { "type": ["string", "null"], "maxLength": 128 }, "evidence_refs": { "$ref": "#/$defs/evidenceRefs" } } },
