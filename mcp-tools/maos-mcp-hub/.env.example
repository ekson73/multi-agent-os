# MAOS MCP Hub - Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ============================================================================
# Bitbucket Server Configuration (required)
# ============================================================================

# Atlassian account email (preferred for Bitbucket REST Basic auth with API token)
BITBUCKET_EMAIL=your-email@company.com

# Shared fallback principal (used if BITBUCKET_EMAIL is empty).
# Reuse the canonical JIRA_EMAIL variable defined in the Jira section below.

# Your Bitbucket username (legacy/basic fallback)
BITBUCKET_USERNAME=your_username

# Bitbucket API token (primary variable).
# For REST APIs, default mode is Basic auth with email+token.
BITBUCKET_API_TOKEN=your_bitbucket_api_token

# Legacy alias (deprecated): old app-password variable
# BITBUCKET_APP_PASSWORD=

# Your Bitbucket workspace (e.g., "my-company")
BITBUCKET_WORKSPACE=your_workspace

# Default repo slug in "workspace/repo-name" format (optional).
# Keep empty for multi-repo mode and pass `repo_slug` per tool call.
BITBUCKET_REPO_SLUG=

# Force auth type: 'bearer' or 'basic' (optional)
# BITBUCKET_AUTH_TYPE=basic

# ============================================================================
# Optional: AI-powered Pipeline Diagnosis (leave empty to disable)
# ============================================================================

# DeepSeek API key for AI diagnosis
DEEPSEEK_API_KEY=

# Google Gemini API key for AI diagnosis
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Mistral Codestral API key for AI diagnosis
MISTRAL_API_KEY=

# ============================================================================
# Jira Server Configuration (required for jira_* tools)
# ============================================================================

# Atlassian account email
JIRA_EMAIL=your-email@company.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Preferred: Jira-specific token (JIRA_API_TOKEN).
# Fallback: shared token for Jira/Confluence (ATLASSIAN_API_TOKEN).
JIRA_API_TOKEN=your_api_token
ATLASSIAN_API_TOKEN=
# Reserved for future Confluence tools in this hub:
CONFLUENCE_API_TOKEN=

# Cloud instance UUID (find at https://your-domain.atlassian.net/_edge/tenant_info)
JIRA_CLOUD_ID=your-cloud-id-uuid

# ============================================================================
# Optional: Multi-Persona / Named Accounts
# ============================================================================
# Define per-account credentials for Bitbucket operations like PR creation,
# approval, and merging. Each account uses a {PREFIX} pattern:
#
#   BITBUCKET_ACCOUNT_{NAME}_USERNAME=email@company.com
#   BITBUCKET_ACCOUNT_{NAME}_APP_PASSWORD=ATxxx...
#   BITBUCKET_ACCOUNT_{NAME}_AUTH_TYPE=basic
#
# Usage in tool calls: account="jane-doe"
# The name is case-insensitive and trimmed (e.g., " Jane-Doe " → "JANE-DOE")
#
# Example — two personas for PR workflows:
#
# BITBUCKET_ACCOUNT_JANE_DOE_USERNAME=jane.doe@company.com
# BITBUCKET_ACCOUNT_JANE_DOE_APP_PASSWORD=your_app_password_here
# BITBUCKET_ACCOUNT_JANE_DOE_AUTH_TYPE=basic
#
# BITBUCKET_ACCOUNT_JOHN_DOE_USERNAME=john.doe@company.com
# BITBUCKET_ACCOUNT_JOHN_DOE_APP_PASSWORD=your_app_password_here
# BITBUCKET_ACCOUNT_JOHN_DOE_AUTH_TYPE=basic

# ============================================================================
# Legacy Flat-Tools Exposure (VKS-1694 deprecation)
# ============================================================================
# Meta-Tools Gateway (atlassian_*) supersedes the flat bitbucket_* / jira_*
# namespace. Flat tools are HIDDEN by default to reduce MCP tool count from
# ~66 to 6 (respecting Gemini/Windsurf 100-tool and ChatGPT ~30-tool limits).
#
# Set to "true" ONLY as a temporary rollback if a consumer still depends on
# flat tool names. Prefer migrating consumers to:
#   atlassian_jira({resource: "...", operation: "...", params: {...}})
#   atlassian_bitbucket({resource: "...", operation: "...", params: {...}})
#
# See README.md section "Migration: Flat → Gateway" for full mapping.

MAOS_EXPOSE_FLAT_TOOLS=false
